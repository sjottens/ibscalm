# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# Your public site URL (canonical links, sitemap, Open Graph). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://ibscalm.com

# ── Payments (doctor's report, iDEAL via Mollie) ─────────────────────────
# Mollie API key: test_... for testing, live_... for real payments. Dashboard → Developers → API keys.
MOLLIE_API_KEY=
# Price of the report in euros (shown in the app and charged by the server).
NEXT_PUBLIC_REPORT_PRICE_EUR=4.99
# Optional. "mock" simulates payments locally (refused on Vercel production). Leave empty to use Mollie when a key is set.
PAYMENT_PROVIDER=
